# RaceMetrics Environment Configuration
# Copy this file to .env and update with your values

# JWT Secret Key - MUST be changed in production
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# MongoDB Configuration
MONGO_URI=mongodb://mongo:27017/racemetrics

# Frontend URLs (for local development)
REACT_APP_API_BASE_URL=http://localhost
REACT_APP_AUTH_SERVICE_URL=http://localhost:5001
REACT_APP_API_FETCH_SERVICE_URL=http://localhost:5002
REACT_APP_DRIVER_SERVICE_URL=http://localhost:5005
REACT_APP_CONSTRUCTOR_SERVICE_URL=http://localhost:5006
REACT_APP_RACE_SERVICE_URL=http://localhost:5007
REACT_APP_STATS_SERVICE_URL=http://localhost:5008
